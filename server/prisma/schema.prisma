// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CUSTOMER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CouponType {
  HOLIDAY
  RANDOM
  CUSTOM
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  username String @unique
  fullName String

  email String @unique
  phone String @unique

  password String

  role Role @default(CUSTOMER)

  avatarUrl String?

  gender Gender?

  verificationToken          String?
  verificationTokenExpiresAt DateTime?

  resetPasswordOtp          String?
  resetPasswordOtpExpiresAt DateTime?

  sessions       Session[]
  address        Address?
  orders         Order[]   @relation("UserOrders")
  approvedOrders Order[]   @relation("ApprovedOrders")
  assignedOrders Order[]   @relation("AssignedOrders")
  posts          Post[]
  uploadedMedia  Media[]
  reviews        Review[]

  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  lastLogin       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  refreshToken String   @unique
  expiresAt    DateTime

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Address {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  receiverName  String
  receiverPhone String

  provinceCity String
  ward         String

  specificAddress String

  isDefault Boolean @default(false)

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  name String @unique
  slug String @unique

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  title String

  slug String @unique

  author String

  publisher String?

  isbn String?

  tagline String? @db.VarChar(255)

  description String? @db.Text

  thumbnail String?

  images Json?

  price Decimal @db.Decimal(12, 2)

  stock Int @default(0)

  soldCount Int @default(0)

  isFeatured Boolean @default(false)

  isActive Boolean @default(true)

  deletedAt DateTime?

  categoryId Int

  category Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  averageRating Float    @default(0)
  reviewCount   Int      @default(0)
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  userId    Int
  productId Int
  orderId   Int

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
}

model Coupon {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  couponType CouponType

  code String @unique

  type DiscountType

  value Decimal @db.Decimal(12, 2)

  minOrderAmount Decimal? @db.Decimal(12, 2)

  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  usageLimit Int?

  usedCount Int @default(0)

  startsAt DateTime?

  expiresAt DateTime

  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  userId          Int
  addressId       Int
  couponId        Int?
  paymentMethodId Int

  approvedById Int?
  assignedToId Int?

  user          User          @relation("UserOrders", fields: [userId], references: [id])
  approvedBy    User?         @relation("ApprovedOrders", fields: [approvedById], references: [id])
  assignedTo    User?         @relation("AssignedOrders", fields: [assignedToId], references: [id])
  address       Address       @relation(fields: [addressId], references: [id])
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  finalAmount    Decimal @db.Decimal(12, 2)

  note String? @db.Text

  items      OrderItem[]
  reviews    Review[]
  assignedAt DateTime?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([approvedById])
  @@index([assignedToId])
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  orderId Int

  productId Int

  title String

  price Decimal @db.Decimal(12, 2)

  quantity Int

  subtotal Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])
}

model PaymentMethod {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  name String @unique
  code String @unique

  description String?

  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  slug  String @unique
  title String

  dek     String @db.Text
  excerpt String @db.Text

  bodyHtml String @db.MediumText

  coverImageUrl String @db.VarChar(2048)

  readMinutes Int

  featured Boolean @default(false)

  publishedAt DateTime?

  status PostStatus @default(DRAFT)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([publishedAt])
  @@index([status])
}

model Media {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  fileName     String
  originalName String

  mimeType String
  size     Int

  url String @db.VarChar(2048)

  type MediaType @default(IMAGE)

  alt    String?
  folder String?

  uploadedById Int?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([type])
}
