generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                         Int       @id @default(autoincrement())
  publicId                   String    @unique @default(uuid())
  username                   String    @unique
  fullName                   String
  email                      String    @unique
  phone                      String    @unique
  password                   String
  role                       Role      @default(CUSTOMER)
  avatarUrl                  String?
  gender                     Gender?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  resetPasswordOtp           String?
  resetPasswordOtpExpiresAt  DateTime?
  emailVerifiedAt            DateTime?
  deletedAt                  DateTime?
  lastLogin                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  address                    Address?
  uploadedMedia              Media[]
  approvedOrders             Order[]   @relation("ApprovedOrders")
  assignedOrders             Order[]   @relation("AssignedOrders")
  orders                     Order[]   @relation("UserOrders")
  posts                      Post[]
  reviews                    Review[]
  sessions                   Session[]
}

model Session {
  id           Int      @id @default(autoincrement())
  publicId     String   @unique @default(uuid())
  refreshToken String   @unique
  expiresAt    DateTime
  userId       Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model Address {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique @default(uuid())
  receiverName    String
  receiverPhone   String
  provinceCity    String
  ward            String
  specificAddress String
  isDefault       Boolean  @default(false)
  userId          Int      @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
}

model Category {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  publicId      String      @unique @default(uuid())
  title         String
  slug          String      @unique
  author        String
  publisher     String?
  isbn          String?
  tagline       String?     @db.VarChar(255)
  description   String?     @db.Text
  thumbnail     String?
  images        Json?
  price         Decimal     @db.Decimal(12, 2)
  stock         Int         @default(0)
  soldCount     Int         @default(0)
  isFeatured    Boolean     @default(false)
  isActive      Boolean     @default(true)
  deletedAt     DateTime?
  categoryId    Int
  averageRating Float       @default(0)
  reviewCount   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  category      Category    @relation(fields: [categoryId], references: [id])
  reviews       Review[]

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model Review {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid())
  userId    Int
  productId Int
  orderId   Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId, orderId])
  @@index([orderId], map: "Review_orderId_fkey")
  @@index([productId], map: "Review_productId_fkey")
}

model Coupon {
  id                Int          @id @default(autoincrement())
  publicId          String       @unique @default(uuid())
  couponType        CouponType
  code              String       @unique
  type              DiscountType
  value             Decimal      @db.Decimal(12, 2)
  minOrderAmount    Decimal?     @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @db.Decimal(12, 2)
  usageLimit        Int?
  usedCount         Int          @default(0)
  startsAt          DateTime?
  expiresAt         DateTime
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  orders            Order[]
}

model Order {
  id              Int           @id @default(autoincrement())
  publicId        String        @unique @default(uuid())
  userId          Int
  addressId       Int
  couponId        Int?
  paymentMethodId Int
  approvedById    Int?
  assignedToId    Int?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  discountAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  finalAmount     Decimal       @db.Decimal(12, 2)
  note            String?       @db.Text
  assignedAt      DateTime?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  address         Address       @relation(fields: [addressId], references: [id])
  approvedBy      User?         @relation("ApprovedOrders", fields: [approvedById], references: [id])
  assignedTo      User?         @relation("AssignedOrders", fields: [assignedToId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation("UserOrders", fields: [userId], references: [id])
  items           OrderItem[]
  reviews         Review[]

  @@index([approvedById])
  @@index([assignedToId])
  @@index([addressId], map: "Order_addressId_fkey")
  @@index([couponId], map: "Order_couponId_fkey")
  @@index([paymentMethodId], map: "Order_paymentMethodId_fkey")
  @@index([userId], map: "Order_userId_fkey")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique @default(uuid())
  orderId   Int
  productId Int
  title     String
  price     Decimal @db.Decimal(12, 2)
  quantity  Int
  subtotal  Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Post {
  id            Int        @id @default(autoincrement())
  publicId      String     @unique @default(uuid())
  slug          String     @unique
  title         String     @default("")
  dek           String?    @db.Text
  excerpt       String?    @db.Text
  bodyHtml      String?    @db.MediumText
  coverImageUrl String?    @db.VarChar(2048)
  readMinutes   Int        @default(1)
  featured      Boolean    @default(false)
  viewCount     Int        @default(0)
  publishedAt   DateTime?
  status        PostStatus @default(DRAFT)
  authorId      Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  author        User       @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([publishedAt])
  @@index([status])
}

model Media {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String    @db.VarChar(2048)
  type         MediaType @default(IMAGE)
  alt          String?
  folder       String?
  uploadedById Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([type])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CUSTOMER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CouponType {
  HOLIDAY
  RANDOM
  CUSTOM
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}
